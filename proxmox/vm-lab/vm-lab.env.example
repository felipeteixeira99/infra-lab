# Copie para vm-lab.env (fica fora do git) e preencha com os valores reais.
# O repo é público: IP, ID de VM e chave ficam só no vm-lab.env.

# --- VM
VMID=""                 # ID livre no Proxmox (qm status <id> deve dizer que não existe)
VM_NAME="lab"
CORES=4
MEMORY=6144             # MB; teto da VM
BALLOON=3072            # MB; o host pode tomar de volta até aqui quando apertar
DISK_SIZE="180G"

# --- Storage (criado pelo preparar-ssd.sh)
STORAGE="ssd-lab"

# --- Imagem cloud (Ubuntu 24.04 LTS "noble")
IMG_URL_BASE="https://cloud-images.ubuntu.com/noble/current"
IMG_FILE="noble-server-cloudimg-amd64.img"
IMG_DIR="/var/lib/vz/template/cloud"

# --- cloud-init
CI_USER="felipe"
SSH_PUBKEY="/root/felipe-lab.pub"   # chave pública copiada para o host (scp)
IP_CIDR=""              # ex.: 192.168.0.50/24 — fora da faixa do DHCP do roteador
GATEWAY=""
NAMESERVER=""           # normalmente o próprio roteador
BRIDGE="vmbr0"
